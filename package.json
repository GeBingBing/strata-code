{
  "name": "strata-code",
  "version": "0.1.0",
  "description": "Strata Code — a Cursor-class desktop AI coding assistant built on the Claude Agent SDK, with layered memory, multi-workspace, and interruptible streaming.",
  "type": "module",
  "main": "out/main/index.js",
  "author": "liwei",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:norestart": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:main && npm run test:renderer",
    "test:main": "vitest run --config vitest.main.config.ts",
    "test:renderer": "vitest run --config vitest.renderer.config.ts",
    "test:watch": "vitest --config vitest.main.config.ts",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.252",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "diff": "^9.0.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
